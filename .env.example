# Copie este ficheiro para ".env" e preencha. O ".env" NUNCA vai para o GitHub.
PORT=3000
NODE_ENV=development

# Segredo da sessão: gere um valor longo e aleatório, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-longo-e-aleatorio

# Base de dados MySQL (XAMPP: utilizador root, senha vazia por defeito)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=consultoria_ti

# Usados apenas pelo comando "npm run create-admin". Apague do .env depois de executar.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=defina-uma-senha-forte-aqui
