<%- include('../partials/header') %>
<h1>Serviços</h1>
<%- include('_nav') %>
<div class="toolbar"><span class="muted"><%= services.length %> serviço(s)</span><a class="btn" href="/admin/servicos/novo">Novo serviço</a></div>
<div class="table-wrap">
  <table>
    <thead><tr><th>ID</th><th>Nome</th><th>Descrição</th><th>Preço</th><th>Ações</th></tr></thead>
    <tbody>
      <% services.forEach(function (s) { %>
        <tr>
          <td><%= s.id %></td>
          <td><%= s.name %></td>
          <td><%= s.description %></td>
          <td><%= fmtMoney(s.price) %></td>
          <td>
            <div class="actions">
              <a class="btn btn-sm btn-outline" href="/admin/servicos/<%= s.id %>/editar">Editar</a>
              <form method="post" action="/admin/servicos/<%= s.id %>/eliminar" data-confirm="Eliminar o serviço “<%= s.name %>”?">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button class="btn btn-sm btn-danger" type="submit">Eliminar</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
